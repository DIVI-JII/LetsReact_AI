{
  "name": "LetsReact_AI-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/migrate.js && node dist/index.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "create-admin": "tsx --env-file=.env src/cli/createAdmin.ts",
    "reset-password": "tsx --env-file=.env src/cli/resetPassword.ts",
    "create-admin:prod": "node dist/cli/createAdmin.js",
    "reset-password:prod": "node dist/cli/resetPassword.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
